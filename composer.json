{
    "name": "themexpert/iquix",
    "description": "Quix installer for Joomla sites with upload limits",
    "type": "joomla-component",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "IQuix\\Setup\\": "setup/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IQuix\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
